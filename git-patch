#!/usr/bin/env bash

set -u

program=${0##*/}

usage() {
  cat <<'EOF'
Usage: git patch <command> [arguments]

Commands:
  add <patch>            Add a patch to the current stack
  list                   List patches in the current stack
  sync [patch]           Synchronize one or all patches
  check-conflicts <patch>
                         Check whether a patch can be applied
  drop [patch]           Drop one or all patches
  log                    Show local stack history
  publish-stacked        Publish the stack as stacked pull requests

Run 'git patch --help' to show this help.
EOF
}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

git_config_key() {
  printf 'git-patch.%s.%s' "$STACK_ID" "$1"
}

patch_id() {
  printf '%s' "$1" | git hash-object --stdin
}

stack_context() {
  CURRENT_BRANCH=$(git symbolic-ref -q --short HEAD) ||
    die "du må stå på en lokal branch"
  STACK_ID=$(printf '%s' "$CURRENT_BRANCH" | git hash-object --stdin)
  STACK_PREFIX="git-patch.$STACK_ID"
  GIT_DIR=$(git rev-parse --git-dir) || die "ikke i et Git-repo"
  STACK_REF="refs/git-patch/stacks/$STACK_ID"
}

stack_base_setup() {
  STACK_BASE=$(git config --local --get "$(git_config_key base)" || true)
  if [ -n "$STACK_BASE" ]; then
    STACK_FEATURE_START=$(git rev-parse "$STACK_REF/feature-start") ||
      die "stack-metadata er ufullstendig"
    return
  fi

  git rev-parse --verify origin/HEAD^{commit} >/dev/null 2>&1 ||
    die "fant ikke origin/HEAD"
  STACK_BASE=$(git merge-base HEAD origin/HEAD) ||
    die "fant ikke felles base med origin/HEAD"
  STACK_FEATURE_START=$STACK_BASE
}

stack_setup() {
  stack_context
  stack_base_setup
}

load_stack() {
  STACK_PATCHES=
  if [ -n "$(git config --local --get-regexp "^$STACK_PREFIX\\.patches\\." 2>/dev/null || true)" ]; then
    STACK_PATCHES=$(git config --local --get-regexp "^$STACK_PREFIX\\.patches\\." |
      sed 's/^[^ ]* *//' | sed '/^$/d')
  fi
}

patch_meta_key() {
  printf '%s.patch.%s.%s' "$STACK_PREFIX" "$1" "$2"
}

patch_name_for_id() {
  git config --local --get "$(patch_meta_key "$1" name)"
}

source_tip_for_id() {
  git rev-parse "$STACK_REF/patch/$1/source"
}

base_tip_for_id() {
  git rev-parse "$STACK_REF/patch/$1/base"
}

stack_patch_ids() {
  printf '%s\n' "$STACK_PATCHES" | sed '/^$/d'
}

source_info() {
  local patch=$1 source="refs/heads/$patch" remote="refs/remotes/origin/$patch"
  local base source_tip

  REMOTE_NEWER=0
  git rev-parse --verify "$source^{commit}" >/dev/null 2>&1 ||
    die "fant ikke den lokale branchen '$patch'"
  base=$(git merge-base "$source" origin/HEAD) ||
    die "fant ikke merge-base for '$patch' og origin/HEAD"
  git rev-list --merges "$base..$source" | grep -q . &&
    die "patch-branchen '$patch' inneholder en merge-commit"

  source_tip=$(git rev-parse "$source^{commit}")
  if git rev-parse --verify "$remote^{commit}" >/dev/null 2>&1; then
    remote_tip=$(git rev-parse "$remote^{commit}")
    if [ "$remote_tip" != "$source_tip" ] &&
      git merge-base --is-ancestor "$source_tip" "$remote_tip"; then
      REMOTE_NEWER=1
    fi
  fi
  SOURCE_BASE=$base
  SOURCE_TIP=$source_tip
}

apply_tree_diff() {
  local from=$1 to=$2 parent=$3 index=$4 error_file=$5

  rm -f "$index"
  GIT_INDEX_FILE=$index git read-tree "$parent" || return 1
  if ! git diff --binary --full-index "$from" "$to" |
    GIT_INDEX_FILE=$index git apply --cached --3way --whitespace=nowarn - \
      >"$error_file" 2>&1; then
    CONFLICT_FILES=$(GIT_INDEX_FILE=$index git ls-files -u |
      awk '{sub(/^[^\t]*\t/, ""); print}' | sort -u)
    [ -n "$CONFLICT_FILES" ] || CONFLICT_FILES=$(sed -n \
      -e 's/^error: patch failed: *//p' \
      -e 's/^CONFLICT (content): Merge conflict in *//p' "$error_file")
    cat "$error_file" >&2
    return 1
  fi
  APPLIED_TREE=$(GIT_INDEX_FILE=$index git write-tree)
}

rewrite_commit_tree() {
  local old=$1 tree=$2 parent=$3
  {
    printf 'tree %s\n' "$tree"
    printf 'parent %s\n' "$parent"
    git cat-file commit "$old" | sed -n '/^author /,$p'
  } | git hash-object -t commit -w --stdin
}

build_stack_tip() {
  local requested_id=$1 requested_name=$2 requested_base=$3 requested_tip=$4
  local id name base snapshot parent tree commit index error_file patch_parent
  local feature_commits first_parent

  index="$GIT_DIR/git-patch-index.$$"
  error_file="$GIT_DIR/git-patch-error.$$"
  rm -f "$index" "$error_file"
  CONFLICT_FILES=
  parent=$STACK_BASE
  for id in $(stack_patch_ids); do
    name=$(patch_name_for_id "$id")
    if [ "$id" = "$requested_id" ]; then
      base=$requested_base
      snapshot=$requested_tip
    else
      base=$(base_tip_for_id "$id")
      snapshot=$(source_tip_for_id "$id")
    fi
    apply_tree_diff "$base" "$snapshot" "$parent" "$index" "$error_file" || {
      rm -f "$index" "$error_file"
      return 1
    }
    tree=$APPLIED_TREE
    commit=$(printf 'git-patch: %s\n' "$name" |
      git commit-tree "$tree" -p "$parent")
    parent=$commit
  done

  if ! stack_patch_ids | grep -q "^$requested_id$"; then
    apply_tree_diff "$requested_base" "$requested_tip" "$parent" \
      "$index" "$error_file" || {
      rm -f "$index" "$error_file"
      return 1
    }
    tree=$APPLIED_TREE
    parent=$(printf 'git-patch: %s\n' "$requested_name" |
      git commit-tree "$tree" -p "$parent")
  fi
  BUILT_PATCH_TIP=$parent

  patch_parent=$STACK_FEATURE_START
  feature_commits=$(git rev-list --reverse "$patch_parent..HEAD" --first-parent)
  for commit in $feature_commits; do
    first_parent=$(git rev-parse "$commit^1") || {
      rm -f "$index" "$error_file"
      return 1
    }
    apply_tree_diff "$first_parent" "$commit" "$parent" \
      "$index" "$error_file" || {
      rm -f "$index" "$error_file"
      return 1
    }
    tree=$APPLIED_TREE
    parent=$(rewrite_commit_tree "$commit" "$tree" "$parent") || {
      rm -f "$index" "$error_file"
      return 1
    }
  done
  BUILT_TIP=$parent
  rm -f "$index" "$error_file"
  return 0
}

build_stack_from_state() {
  local i id name base snapshot parent tree commit index error_file
  local first_parent feature_commits

  index="$GIT_DIR/git-patch-index.$$"
  error_file="$GIT_DIR/git-patch-error.$$"
  rm -f "$index" "$error_file"
  CONFLICT_FILES=
  parent=$BUILD_BASE

  for ((i = 0; i < ${#BUILD_IDS[@]}; i++)); do
    id=${BUILD_IDS[$i]}
    name=${BUILD_NAMES[$i]}
    base=${BUILD_BASES[$i]}
    snapshot=${BUILD_TIPS[$i]}
    apply_tree_diff "$base" "$snapshot" "$parent" "$index" "$error_file" || {
      rm -f "$index" "$error_file"
      return 1
    }
    tree=$APPLIED_TREE
    commit=$(printf 'git-patch: %s\n' "$name" |
      git commit-tree "$tree" -p "$parent")
    parent=$commit
  done
  BUILT_PATCH_TIP=$parent

  feature_commits=$(git rev-list --reverse "$STACK_FEATURE_START..HEAD" --first-parent)
  for commit in $feature_commits; do
    first_parent=$(git rev-parse "$commit^1") || {
      rm -f "$index" "$error_file"
      return 1
    }
    apply_tree_diff "$first_parent" "$commit" "$parent" \
      "$index" "$error_file" || {
      rm -f "$index" "$error_file"
      return 1
    }
    tree=$APPLIED_TREE
    parent=$(rewrite_commit_tree "$commit" "$tree" "$parent") || {
      rm -f "$index" "$error_file"
      return 1
    }
  done
  BUILT_TIP=$parent
  rm -f "$index" "$error_file"
  return 0
}

prepare_single_sync_build() {
  local requested_id=$1 requested_base=$2 requested_tip=$3
  local id

  BUILD_BASE=$STACK_BASE
  BUILD_IDS=()
  BUILD_NAMES=()
  BUILD_BASES=()
  BUILD_TIPS=()
  for id in $(stack_patch_ids); do
    BUILD_IDS[${#BUILD_IDS[@]}]=$id
    BUILD_NAMES[${#BUILD_NAMES[@]}]=$(patch_name_for_id "$id")
    if [ "$id" = "$requested_id" ]; then
      BUILD_BASES[${#BUILD_BASES[@]}]=$requested_base
      BUILD_TIPS[${#BUILD_TIPS[@]}]=$requested_tip
    else
      BUILD_BASES[${#BUILD_BASES[@]}]=$(base_tip_for_id "$id")
      BUILD_TIPS[${#BUILD_TIPS[@]}]=$(source_tip_for_id "$id")
    fi
  done
}

print_dependency_error() {
  die "patchen '$1' avhenger av den aktive patchen '$2' (patcher kan ikke bygge på hverandre)"
}

check_dependencies() {
  local requested=$1 requested_tip=$2 id name active_tip
  for id in $(stack_patch_ids); do
    name=$(patch_name_for_id "$id")
    active_tip=$(source_tip_for_id "$id")
    if git merge-base --is-ancestor "$active_tip" "$requested_tip" 2>/dev/null; then
      print_dependency_error "$requested" "$name"
    fi
    if git merge-base --is-ancestor "$requested_tip" "$active_tip" 2>/dev/null; then
      print_dependency_error "$name" "$requested"
    fi
  done
}

print_conflicts() {
  local action=$1 patch=$2
  if [ -n "$CONFLICT_FILES" ]; then
    printf 'Kan ikke %s patchen %s på grunn av conflict i:\n' \
      "$action" "$patch" >&2
    printf '%s\n' "$CONFLICT_FILES" | sed 's/^/  /' >&2
  else
    printf 'Kan ikke %s patchen %s på grunn av conflict.\n' \
      "$action" "$patch" >&2
  fi
}

has_worktree_changes() {
  [ -n "$(git status --porcelain --untracked-files=all)" ]
}

restore_stash() {
  local oid=$1
  git stash apply --index -q "$oid" 2>/dev/null ||
    die "kunne ikke legge tilbake stashen $oid automatisk"
}

save_stack_metadata() {
  local patch=$1 id=$2 source_base=$3 source_tip=$4 original_head=$5

  git config --local "$(git_config_key branch)" "$CURRENT_BRANCH"
  git config --local "$(git_config_key base)" "$STACK_BASE"
  git update-ref "$STACK_REF/base" "$STACK_BASE"
  git update-ref "$STACK_REF/feature-start" "$BUILT_PATCH_TIP"
  git update-ref "$STACK_REF/head" "$BUILT_TIP"

  if ! stack_patch_ids | grep -q "^$id$"; then
    git config --local --add "$STACK_PREFIX.patches.value" "$id"
    git config --local "$(patch_meta_key "$id" name)" "$patch"
  fi
  git config --local "$(patch_meta_key "$id" source)" "$patch"
  git update-ref "$STACK_REF/patch/$id/base" "$source_base"
  git update-ref "$STACK_REF/patch/$id/source" "$source_tip"
  git config --local "$(patch_meta_key "$id" source-tip)" "$source_tip"
  git config --local --add "$STACK_PREFIX.operations.value" \
    "added $patch from $source_tip"
  if [ -n "$original_head" ]; then
    git update-ref "$STACK_REF/original-head" "$original_head"
  fi
}

command_check_conflicts() {
  [ "$#" -eq 1 ] || die "bruk: git patch check-conflicts <patch>"
  local patch=$1 id

  stack_setup
  load_stack
  id=$(patch_id "$patch")
  if ! stack_patch_ids | grep -q "^$id$"; then
    check_dependencies "$patch" "$(git rev-parse "refs/heads/$patch^{commit}" 2>/dev/null ||
      die "fant ikke den lokale branchen '$patch'")"
  fi
  source_info "$patch"

  if build_stack_tip "$id" "$patch" "$SOURCE_BASE" "$SOURCE_TIP"; then
    printf 'Ingen conflict: patchen %s kan brukes uten konflikter.\n' "$patch"
    return 0
  fi
  print_conflicts "bruke" "$patch"
  printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
  return 1
}

command_add() {
  [ "$#" -eq 1 ] || die "bruk: git patch add <patch>"
  local patch=$1 id original_head stash_oid= candidate_tip
  local had_stash=0

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "ikke i et Git-repo"
  stack_setup
  load_stack
  id=$(patch_id "$patch")
  stack_patch_ids | grep -q "^$id$" &&
    die "patchen '$patch' er allerede lagt til"

  if git remote get-url origin >/dev/null 2>&1; then
    git fetch -q origin 2>/dev/null || true
  fi
  source_info "$patch"
  check_dependencies "$patch" "$SOURCE_TIP"
  original_head=$(git rev-parse HEAD)
  if has_worktree_changes; then
    git stash push -u -q -m "git-patch: pending add $patch" ||
      die "kunne ikke stash'e ucommittede endringer"
    stash_oid=$(git rev-parse refs/stash)
    had_stash=1
  fi

  if ! build_stack_tip "$id" "$patch" "$SOURCE_BASE" "$SOURCE_TIP"; then
    print_conflicts "legge til" "$patch"
    printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
    if [ "$had_stash" -eq 1 ]; then
      restore_stash "$stash_oid"
      printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
    fi
    return 1
  fi
  candidate_tip=$BUILT_TIP

  if ! git reset --hard -q "$candidate_tip"; then
    if [ "$had_stash" -eq 1 ]; then
      restore_stash "$stash_oid"
    fi
    die "kunne ikke oppdatere feature-branchen"
  fi
  if [ "$had_stash" -eq 1 ] &&
    ! git stash apply --index -q "$stash_oid"; then
    git reset --hard -q "$original_head"
    restore_stash "$stash_oid"
    printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
    printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
    return 1
  fi
  [ "$had_stash" -eq 0 ] || git stash drop -q "stash@{0}"

  save_stack_metadata "$patch" "$id" "$SOURCE_BASE" "$SOURCE_TIP" "$original_head"

  if [ "${REMOTE_NEWER-0}" -eq 1 ]; then
    printf 'origin/%s er nyere enn lokal %s\n' "$patch" "$patch" >&2
    printf 'Lokal %s ble lagt til. Oppdater den lokale %s-branchen og kjør `git patch sync %s` hvis remote-versjonen skal brukes.\n' \
      "$patch" "$patch" "$patch" >&2
  fi
  printf 'La til patchen %s på feature-branchen.\n' "$patch"
}

warn_remote_newer() {
  [ "${REMOTE_NEWER-0}" -eq 1 ] || return 0
  printf 'origin/%s er nyere enn lokal %s\n' "$1" "$1" >&2
  printf 'Lokal %s brukes. Oppdater den lokale %s-branchen og kjør `git patch sync %s` hvis remote-versjonen skal brukes.\n' \
    "$1" "$1" "$1" >&2
}

stash_sync_work() {
  SYNC_STASH_OID=
  if has_worktree_changes; then
    git stash push -u -q -m "git-patch: pending sync" ||
      die "kunne ikke stash'e ucommittede endringer"
    SYNC_STASH_OID=$(git rev-parse refs/stash)
  fi
}

restore_sync_stash() {
  local keep=$1
  [ -n "$SYNC_STASH_OID" ] || return 0
  if git stash apply --index -q "$SYNC_STASH_OID"; then
    if [ "$keep" -eq 0 ] &&
      [ "$(git rev-parse --verify -q refs/stash || true)" = "$SYNC_STASH_OID" ]; then
      git stash drop -q "stash@{0}"
    fi
    return 0
  fi
  printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
  return 1
}

log_sync_rollback() {
  git config --local --add "$STACK_PREFIX.operations.value" \
    "rolled back sync after conflicts"
}

sync_conflict_failure() {
  local patch=$1
  print_conflicts "synkronisere" "$patch"
  printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
  if [ -n "$SYNC_STASH_OID" ]; then
    restore_sync_stash 0 || return 1
  fi
  log_sync_rollback ||
    printf 'Kunne ikke lagre rollback-operasjonen i stack-loggen.\n' >&2
  return 1
}

finish_sync_branch() {
  local original_head=$1
  local candidate_tip=$2

  if ! git reset --hard -q "$candidate_tip"; then
    git reset --hard -q "$original_head"
    restore_sync_stash 0 || true
    die "kunne ikke oppdatere feature-branchen"
  fi
  if [ -n "$SYNC_STASH_OID" ] &&
    ! git stash apply --index -q "$SYNC_STASH_OID"; then
    if ! git reset --hard -q "$original_head" ||
      ! git clean -fdq ||
      ! git stash apply --index -q "$SYNC_STASH_OID"; then
      printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
      return 1
    fi
    if [ "$(git rev-parse --verify -q refs/stash || true)" = "$SYNC_STASH_OID" ]; then
      git stash drop -q "stash@{0}" || {
        printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
        return 1
      }
    fi
    printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
    log_sync_rollback ||
      printf 'Kunne ikke lagre rollback-operasjonen i stack-loggen.\n' >&2
    return 1
  fi
  [ -z "$SYNC_STASH_OID" ] || git stash drop -q "stash@{0}"
}

save_synced_patch() {
  local patch=$1 id=$2 source_base=$3 source_tip=$4

  git config --local "$(patch_meta_key "$id" source)" "$patch"
  git config --local "$(patch_meta_key "$id" source-tip)" "$source_tip"
  git update-ref "$STACK_REF/patch/$id/base" "$source_base"
  git update-ref "$STACK_REF/patch/$id/source" "$source_tip"
  git update-ref "$STACK_REF/feature-start" "$BUILT_PATCH_TIP"
  git update-ref "$STACK_REF/head" "$BUILT_TIP"
  git config --local --add "$STACK_PREFIX.operations.value" \
    "synced $patch from $source_tip"
}

command_sync_patch() {
  [ "$#" -eq 1 ] || die "bruk: git patch sync [patch]"
  local patch=$1 id original_head

  stack_setup
  load_stack
  id=$(patch_id "$patch")
  stack_patch_ids | grep -q "^$id$" ||
    die "patchen '$patch' er ikke lagt til"

  source_info "$patch"
  prepare_single_sync_build "$id" "$SOURCE_BASE" "$SOURCE_TIP"
  original_head=$(git rev-parse HEAD)
  stash_sync_work

  if ! build_stack_from_state; then
    sync_conflict_failure "$patch"
    return 1
  fi
  if ! finish_sync_branch "$original_head" "$BUILT_TIP"; then
    return 1
  fi
  save_synced_patch "$patch" "$id" "$SOURCE_BASE" "$SOURCE_TIP"
  warn_remote_newer "$patch"
  printf 'Synkroniserte patchen %s.\n' "$patch"
}

patch_change_id() {
  git diff --binary "$1" "$2" | git patch-id --stable |
    awk 'NR == 1 { print $1 }'
}

patch_is_delivered() {
  local old_base=$1 source_tip=$2 new_main=$3
  local change_id main_commit index

  if git merge-base --is-ancestor "$source_tip" "$new_main" 2>/dev/null; then
    return 0
  fi

  change_id=$(patch_change_id "$old_base" "$source_tip")
  if [ -z "$change_id" ]; then
    return 0
  fi
  for main_commit in $(git rev-list "$STACK_BASE..$new_main"); do
    if [ "$(git show --pretty=format: "$main_commit" | git patch-id --stable |
      awk 'NR == 1 { print $1 }')" = "$change_id" ]; then
      return 0
    fi
  done

  index="$GIT_DIR/git-patch-delivery-check.$$"
  rm -f "$index"
  GIT_INDEX_FILE=$index git read-tree "$new_main" || {
    rm -f "$index"
    return 1
  }
  if git diff --binary --full-index "$old_base" "$source_tip" |
    GIT_INDEX_FILE=$index git apply --cached --check --reverse \
      --whitespace=nowarn - >/dev/null 2>&1; then
    rm -f "$index"
    return 0
  fi
  rm -f "$index"
  return 1
}

patch_may_be_delivered() {
  local old_base=$1 source_tip=$2 new_main=$3 path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if git diff --name-only "$STACK_BASE" "$new_main" | grep -Fxq "$path"; then
      return 0
    fi
  done < <(git diff --name-only "$old_base" "$source_tip")
  return 1
}

patch_can_apply() {
  local old_base=$1 source_tip=$2 new_main=$3 index

  index="$GIT_DIR/git-patch-delivery-check.$$"
  rm -f "$index"
  GIT_INDEX_FILE=$index git read-tree "$new_main" || {
    rm -f "$index"
    return 1
  }
  if git diff --binary --full-index "$old_base" "$source_tip" |
    GIT_INDEX_FILE=$index git apply --cached --check \
      --whitespace=nowarn - >/dev/null 2>&1; then
    rm -f "$index"
    return 0
  fi
  rm -f "$index"
  return 1
}

confirm_uncertain_delivery() {
  local patch=$1 answer

  printf "Patchen %s kan være bare delvis eller endret levert i main; du må bekrefte fjerning. [j/N] " \
    "$patch" >&2
  IFS= read -r answer || answer=n
  case $answer in
    j|J|ja|JA|y|Y|yes|YES) return 0 ;;
    *)
      printf 'Synkronisering avbrutt. Ingen endringer ble gjort.\n' >&2
      return 1
      ;;
  esac
}

remove_patch_metadata() {
  local id=$1

  git config --local --unset-all "$STACK_PREFIX.patches.value" "^$id$" || true
  git config --local --unset-all "$(patch_meta_key "$id" name)" || true
  git config --local --unset-all "$(patch_meta_key "$id" source)" || true
  git config --local --unset-all "$(patch_meta_key "$id" source-tip)" || true
  git update-ref -d "$STACK_REF/patch/$id/base"
  git update-ref -d "$STACK_REF/patch/$id/source"
}

save_full_sync_metadata() {
  local i id patch

  git config --local "$(git_config_key base)" "$BUILD_BASE"
  git update-ref "$STACK_REF/base" "$BUILD_BASE"
  for id in $(stack_patch_ids); do
    if ! printf '%s\n' "${RETAINED_IDS[@]}" | grep -qx "$id"; then
      remove_patch_metadata "$id"
    fi
  done
  for ((i = 0; i < ${#BUILD_IDS[@]}; i++)); do
    id=${BUILD_IDS[$i]}
    patch=${BUILD_NAMES[$i]}
    git update-ref "$STACK_REF/patch/$id/base" "${BUILD_BASES[$i]}"
    git update-ref "$STACK_REF/patch/$id/source" "${BUILD_TIPS[$i]}"
    git config --local "$(patch_meta_key "$id" source-tip)" "${BUILD_TIPS[$i]}"
    git config --local --add "$STACK_PREFIX.operations.value" \
      "synced $patch from ${BUILD_TIPS[$i]}"
  done
  for ((i = 0; i < ${#DELIVERED_IDS[@]}; i++)); do
    patch=${DELIVERED_NAMES[$i]}
    git config --local --add "$STACK_PREFIX.operations.value" \
      "dropped $patch because its change was found in main"
  done
  git update-ref "$STACK_REF/feature-start" "$BUILT_PATCH_TIP"
  git update-ref "$STACK_REF/head" "$BUILT_TIP"
}

command_sync_all() {
  local id patch active_base active_tip source_tip original_head new_main
  local active_delivered current_delivered delivered uncertain

  stack_setup
  load_stack
  [ -n "$STACK_PATCHES" ] || die "ingen aktive patcher å synkronisere"
  git fetch -q origin || die "kunne ikke hente fra origin"
  new_main=$(git rev-parse "origin/HEAD^{commit}") ||
    die "fant ikke origin/HEAD"

  BUILD_BASE=$new_main
  BUILD_IDS=()
  BUILD_NAMES=()
  BUILD_BASES=()
  BUILD_TIPS=()
  RETAINED_IDS=()
  DELIVERED_IDS=()
  DELIVERED_NAMES=()

  for id in $(stack_patch_ids); do
    patch=$(patch_name_for_id "$id")
    source_info "$patch"
    active_base=$(base_tip_for_id "$id")
    active_tip=$(source_tip_for_id "$id")
    source_tip=$SOURCE_TIP
    warn_remote_newer "$patch"

    active_delivered=0
    if patch_is_delivered "$active_base" "$active_tip" "$new_main"; then
      active_delivered=1
    fi
    current_delivered=0
    if patch_is_delivered "$SOURCE_BASE" "$source_tip" "$new_main"; then
      current_delivered=1
    fi
    delivered=0
    if [ "$current_delivered" -eq 1 ] ||
      { [ "$active_tip" != "$source_tip" ] &&
        [ "$active_delivered" -eq 1 ] &&
        patch_is_delivered "$active_tip" "$source_tip" "$new_main"; }; then
      delivered=1
    fi
    if [ "$delivered" -eq 1 ]; then
      DELIVERED_IDS[${#DELIVERED_IDS[@]}]=$id
      DELIVERED_NAMES[${#DELIVERED_NAMES[@]}]=$patch
      continue
    fi

    uncertain=0
    if [ "$active_tip" != "$source_tip" ] &&
      [ "$active_delivered" -eq 1 ]; then
      if ! patch_can_apply "$active_tip" "$source_tip" "$new_main"; then
        uncertain=1
      fi
    elif patch_may_be_delivered "$SOURCE_BASE" "$source_tip" "$new_main"; then
      uncertain=1
    fi
    if [ "$uncertain" -eq 1 ]; then
      if ! confirm_uncertain_delivery "$patch"; then
        return 1
      fi
      DELIVERED_IDS[${#DELIVERED_IDS[@]}]=$id
      DELIVERED_NAMES[${#DELIVERED_NAMES[@]}]=$patch
      continue
    fi
    BUILD_IDS[${#BUILD_IDS[@]}]=$id
    BUILD_NAMES[${#BUILD_NAMES[@]}]=$patch
    if [ "$active_tip" != "$source_tip" ] &&
      [ "$active_delivered" -eq 1 ]; then
      BUILD_BASES[${#BUILD_BASES[@]}]=$active_tip
    else
      BUILD_BASES[${#BUILD_BASES[@]}]=$SOURCE_BASE
    fi
    BUILD_TIPS[${#BUILD_TIPS[@]}]=$source_tip
    RETAINED_IDS[${#RETAINED_IDS[@]}]=$id
  done

  original_head=$(git rev-parse HEAD)
  stash_sync_work
  if ! build_stack_from_state; then
    sync_conflict_failure "stacken"
    return 1
  fi
  if ! finish_sync_branch "$original_head" "$BUILT_TIP"; then
    return 1
  fi
  save_full_sync_metadata
  printf 'Synkroniserte patch-stacken mot oppdatert main.\n'
}

command_sync() {
  case $# in
    0) command_sync_all ;;
    1) command_sync_patch "$1" ;;
    *) die "bruk: git patch sync [patch]" ;;
  esac
}

prepare_drop_build() {
  local requested_id=$1 id

  BUILD_BASE=$STACK_BASE
  BUILD_IDS=()
  BUILD_NAMES=()
  BUILD_BASES=()
  BUILD_TIPS=()
  DROPPED_IDS=()
  DROPPED_NAMES=()

  for id in $(stack_patch_ids); do
    if [ -z "$requested_id" ] || [ "$id" = "$requested_id" ]; then
      DROPPED_IDS[${#DROPPED_IDS[@]}]=$id
      DROPPED_NAMES[${#DROPPED_NAMES[@]}]=$(patch_name_for_id "$id")
      continue
    fi
    BUILD_IDS[${#BUILD_IDS[@]}]=$id
    BUILD_NAMES[${#BUILD_NAMES[@]}]=$(patch_name_for_id "$id")
    BUILD_BASES[${#BUILD_BASES[@]}]=$(base_tip_for_id "$id")
    BUILD_TIPS[${#BUILD_TIPS[@]}]=$(source_tip_for_id "$id")
  done
}

stash_drop_work() {
  DROP_STASH_OID=
  if has_worktree_changes; then
    git stash push -u -q -m "git-patch: pending drop" ||
      die "kunne ikke stash'e ucommittede endringer"
    DROP_STASH_OID=$(git rev-parse refs/stash)
  fi
}

restore_drop_stash() {
  local keep=$1
  [ -n "$DROP_STASH_OID" ] || return 0
  if git stash apply --index -q "$DROP_STASH_OID"; then
    if [ "$keep" -eq 0 ] &&
      [ "$(git rev-parse --verify -q refs/stash || true)" = "$DROP_STASH_OID" ]; then
      git stash drop -q "stash@{0}"
    fi
    return 0
  fi
  printf 'Dine ucommittede endringer ligger i stash@{0}.\n' >&2
  return 1
}

rollback_drop_branch() {
  local original_head=$1

  git reset --hard -q "$original_head" || return 1
  git clean -fdq || return 1
  restore_drop_stash 0
}

drop_conflict_failure() {
  local patch=$1
  print_conflicts "fjerne" "$patch"
  printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
  if [ -n "$DROP_STASH_OID" ]; then
    restore_drop_stash 0 || true
  fi
  return 1
}

finish_drop_branch() {
  local original_head=$1 candidate_tip=$2

  if ! git reset --hard -q "$candidate_tip"; then
    rollback_drop_branch "$original_head" || true
    rm -f "$DROP_CONFIG_SNAPSHOT"
    die "kunne ikke oppdatere feature-branchen"
  fi
  if [ -n "$DROP_STASH_OID" ] &&
    ! git stash apply --index -q "$DROP_STASH_OID"; then
    rollback_drop_branch "$original_head" || true
    printf 'Ingen endringer ble gjort i feature-branchen.\n' >&2
    return 1
  fi
}

snapshot_drop_metadata() {
  local config id ref oid

  DROP_CONFIG=$(git rev-parse --git-path config) ||
    die "fant ikke lokal Git-konfigurasjon"
  DROP_CONFIG_SNAPSHOT="$GIT_DIR/git-patch-drop-config.$$"
  cp "$DROP_CONFIG" "$DROP_CONFIG_SNAPSHOT" ||
    die "kunne ikke ta sikkerhetskopi av stack-metadata"
  DROP_REF_NAMES=(
    "$STACK_REF/base"
    "$STACK_REF/feature-start"
    "$STACK_REF/head"
  )
  for id in "${DROPPED_IDS[@]}"; do
    DROP_REF_NAMES[${#DROP_REF_NAMES[@]}]="$STACK_REF/patch/$id/base"
    DROP_REF_NAMES[${#DROP_REF_NAMES[@]}]="$STACK_REF/patch/$id/source"
  done
  DROP_REF_OIDS=()
  for ref in "${DROP_REF_NAMES[@]}"; do
    oid=$(git rev-parse --verify "$ref^{commit}" 2>/dev/null || true)
    DROP_REF_OIDS[${#DROP_REF_OIDS[@]}]=$oid
  done
  DROP_REFS_UPDATED=0
}

restore_drop_metadata() {
  local i

  cp "$DROP_CONFIG_SNAPSHOT" "$DROP_CONFIG" || return 1
  if [ "$DROP_REFS_UPDATED" -eq 1 ]; then
    {
      for ((i = 0; i < ${#DROP_REF_NAMES[@]}; i++)); do
        if [ -n "${DROP_REF_OIDS[$i]}" ]; then
          printf 'update %s %s\n' \
            "${DROP_REF_NAMES[$i]}" "${DROP_REF_OIDS[$i]}"
        else
          printf 'delete %s\n' "${DROP_REF_NAMES[$i]}"
        fi
      done
    } | git update-ref --stdin || return 1
  fi
}

save_drop_metadata() {
  local id patch i=0

  git config --local "$(git_config_key base)" "$BUILD_BASE" || {
    restore_drop_metadata || true
    return 1
  }
  for id in "${DROPPED_IDS[@]}"; do
    git config --local --unset-all \
      "$STACK_PREFIX.patches.value" "^$id$" || [ "$?" -eq 5 ] || {
        restore_drop_metadata || true
        return 1
      }
    git config --local --unset-all "$(patch_meta_key "$id" name)" ||
      [ "$?" -eq 5 ] || {
        restore_drop_metadata || true
        return 1
      }
    git config --local --unset-all "$(patch_meta_key "$id" source)" ||
      [ "$?" -eq 5 ] || {
        restore_drop_metadata || true
        return 1
      }
    git config --local --unset-all "$(patch_meta_key "$id" source-tip)" ||
      [ "$?" -eq 5 ] || {
        restore_drop_metadata || true
        return 1
      }
    patch=${DROPPED_NAMES[$i]}
    git config --local --add "$STACK_PREFIX.operations.value" \
      "dropped $patch" || {
        restore_drop_metadata || true
        return 1
      }
    i=$((i + 1))
  done
  {
    printf 'update %s %s %s\n' \
      "$STACK_REF/base" "$BUILD_BASE" "${DROP_REF_OIDS[0]}"
    printf 'update %s %s %s\n' \
      "$STACK_REF/feature-start" "$BUILT_PATCH_TIP" "${DROP_REF_OIDS[1]}"
    printf 'update %s %s %s\n' \
      "$STACK_REF/head" "$BUILT_TIP" "${DROP_REF_OIDS[2]}"
    i=3
    for id in "${DROPPED_IDS[@]}"; do
      printf 'delete %s %s\n' \
        "$STACK_REF/patch/$id/base" "${DROP_REF_OIDS[$i]}"
      i=$((i + 1))
      printf 'delete %s %s\n' \
        "$STACK_REF/patch/$id/source" "${DROP_REF_OIDS[$i]}"
      i=$((i + 1))
    done
  } | git update-ref --stdin || {
    restore_drop_metadata || true
    return 1
  }
  DROP_REFS_UPDATED=1
}

command_drop() {
  [ "$#" -le 1 ] || die "bruk: git patch drop [patch]"
  local requested=${1-}
  local requested_id= original_head candidate_tip new_main patch

  stack_setup
  load_stack
  [ -n "$STACK_PATCHES" ] || {
    if [ -n "$requested" ]; then
      die "patchen '$requested' er ikke lagt til"
    fi
    die "ingen aktive patcher å fjerne"
  }
  if [ -n "$requested" ]; then
    requested_id=$(patch_id "$requested")
    stack_patch_ids | grep -q "^$requested_id$" ||
      die "patchen '$requested' er ikke lagt til"
  fi

  git fetch -q origin || die "kunne ikke hente fra origin"
  new_main=$(git rev-parse "origin/HEAD^{commit}") ||
    die "fant ikke origin/HEAD"
  STACK_BASE=$new_main
  prepare_drop_build "$requested_id"

  original_head=$(git rev-parse HEAD)
  snapshot_drop_metadata
  stash_drop_work
  if ! build_stack_from_state; then
    drop_conflict_failure "${requested:-stacken}"
    rm -f "$DROP_CONFIG_SNAPSHOT"
    return 1
  fi
  candidate_tip=$BUILT_TIP
  if ! finish_drop_branch "$original_head" "$candidate_tip"; then
    rm -f "$DROP_CONFIG_SNAPSHOT"
    return 1
  fi
  save_drop_metadata || {
    rollback_drop_branch "$original_head" || true
    rm -f "$DROP_CONFIG_SNAPSHOT"
    die "kunne ikke lagre oppdatert stack-metadata"
  }
  if [ -n "$DROP_STASH_OID" ] &&
    ! git stash drop -q "stash@{0}"; then
    restore_drop_metadata || true
    rollback_drop_branch "$original_head" || true
    rm -f "$DROP_CONFIG_SNAPSHOT"
    die "kunne ikke fullføre oppdatering av stash"
  fi
  rm -f "$DROP_CONFIG_SNAPSHOT"

  for patch in "${DROPPED_NAMES[@]}"; do
    printf 'Fjernet patchen %s fra stacken.\n' "$patch"
  done
}

list_patch_delivery() {
  local active_base=$1 active_tip=$2 main_tip

  main_tip=$(git rev-parse --verify "origin/HEAD^{commit}" 2>/dev/null || true)
  if [ -z "$main_tip" ]; then
    LIST_DELIVERY=unknown
    return
  fi
  if patch_is_delivered "$active_base" "$active_tip" "$main_tip"; then
    LIST_DELIVERY=delivered
  elif patch_may_be_delivered "$active_base" "$active_tip" "$main_tip"; then
    LIST_DELIVERY="possibly delivered"
  else
    LIST_DELIVERY="not detected"
  fi
}

list_patch_conflicts() {
  local i id base snapshot parent tree index error_file patch_parent commit first_parent
  local feature_commits simulation_objects real_objects

  index="$GIT_DIR/git-patch-list-index.$$"
  error_file="$GIT_DIR/git-patch-list-error.$$"
  simulation_objects="$GIT_DIR/git-patch-list-objects.$$"
  real_objects=$(git rev-parse --git-path objects)
  rm -f "$index" "$error_file"
  rm -rf "$simulation_objects"
  mkdir -p "$simulation_objects"
  simulation_objects=$(cd "$simulation_objects" && pwd)
  real_objects=$(cd "$real_objects" && pwd)
  CONFLICT_FILES=
  LIST_STACK_CONFLICTS=none
  parent=$STACK_BASE
  for ((i = 0; i < ${#LIST_IDS[@]}; i++)); do
    base=${LIST_BASES[$i]}
    snapshot=${LIST_TIPS[$i]}
    CONFLICT_FILES=
    if ! GIT_OBJECT_DIRECTORY=$simulation_objects \
      GIT_ALTERNATE_OBJECT_DIRECTORIES=$real_objects \
      apply_tree_diff "$base" "$snapshot" "$parent" "$index" "$error_file" \
      >/dev/null 2>&1; then
      LIST_CONFLICTS[$i]=${CONFLICT_FILES:-detected}
      rm -f "$index" "$error_file"
      rm -rf "$simulation_objects"
      return
    fi
    LIST_CONFLICTS[$i]=none
    parent=$APPLIED_TREE
  done

  patch_parent=$STACK_FEATURE_START
  feature_commits=$(git rev-list --reverse "$patch_parent..HEAD" --first-parent)
  for commit in $feature_commits; do
    first_parent=$(git rev-parse "$commit^1") || {
      LIST_STACK_CONFLICTS=unknown
      rm -f "$index" "$error_file"
      rm -rf "$simulation_objects"
      return
    }
    CONFLICT_FILES=
    if ! GIT_OBJECT_DIRECTORY=$simulation_objects \
      GIT_ALTERNATE_OBJECT_DIRECTORIES=$real_objects \
      apply_tree_diff "$first_parent" "$commit" "$parent" \
        "$index" "$error_file" >/dev/null 2>&1; then
      LIST_STACK_CONFLICTS=${CONFLICT_FILES:-detected}
      rm -f "$index" "$error_file"
      rm -rf "$simulation_objects"
      return
    fi
    parent=$APPLIED_TREE
  done
  rm -f "$index" "$error_file"
  rm -rf "$simulation_objects"
}

command_list() {
  [ "$#" -eq 0 ] || die "bruk: git patch list"
  local id patch source current_tip active_tip active_base source_base
  local source_state conflict_reason order=0 i
  local can_replay=1

  stack_context
  load_stack
  if [ -z "$STACK_PATCHES" ]; then
    printf '0 active patches\n'
    return
  fi
  stack_base_setup

  LIST_IDS=()
  LIST_NAMES=()
  LIST_SOURCES=()
  LIST_STATES=()
  LIST_ACTIVE_BASES=()
  LIST_ACTIVE_TIPS=()
  LIST_BASES=()
  LIST_TIPS=()
  LIST_DELIVERIES=()
  LIST_CONFLICTS=()
  LIST_STACK_CONFLICTS=none

  for id in $(stack_patch_ids); do
    source_base=
    source_state=
    conflict_reason=
    patch=$(patch_name_for_id "$id")
    source=$(git config --local --get "$(patch_meta_key "$id" source)" ||
      printf '%s' "$patch")
    active_base=$(base_tip_for_id "$id")
    active_tip=$(source_tip_for_id "$id")
    current_tip=$(git rev-parse --verify "refs/heads/$source^{commit}" 2>/dev/null ||
      true)

    source_state=current
    if [ -z "$current_tip" ]; then
      source_state=missing
    elif [ "$current_tip" != "$active_tip" ]; then
      source_state=outdated
    fi

    LIST_IDS[${#LIST_IDS[@]}]=$id
    LIST_NAMES[${#LIST_NAMES[@]}]=$patch
    LIST_SOURCES[${#LIST_SOURCES[@]}]=$source
    LIST_STATES[${#LIST_STATES[@]}]=$source_state
    LIST_ACTIVE_BASES[${#LIST_ACTIVE_BASES[@]}]=$active_base
    LIST_ACTIVE_TIPS[${#LIST_ACTIVE_TIPS[@]}]=$active_tip
    LIST_TIPS[${#LIST_TIPS[@]}]=${current_tip:-}

    list_patch_delivery "$active_base" "$active_tip"
    LIST_DELIVERIES[${#LIST_DELIVERIES[@]}]=$LIST_DELIVERY
    if [ -z "$current_tip" ]; then
      conflict_reason=unknown
    else
      if [ "$current_tip" = "$active_tip" ]; then
        source_base=$active_base
      else
        source_base=$(git merge-base "$current_tip" origin/HEAD 2>/dev/null || true)
      fi
      if [ -z "$source_base" ]; then
        conflict_reason=unknown
      elif [ -n "$(git rev-list --merges "$source_base..$current_tip")" ]; then
        conflict_reason="unknown (source contains a merge commit)"
      fi
    fi
    LIST_BASES[${#LIST_BASES[@]}]=${source_base:-}
    if [ -n "$conflict_reason" ]; then
      LIST_CONFLICTS[${#LIST_CONFLICTS[@]}]=$conflict_reason
      can_replay=0
    else
      LIST_CONFLICTS[${#LIST_CONFLICTS[@]}]=unknown
    fi
  done

  if [ "$can_replay" -eq 1 ]; then
    list_patch_conflicts
  else
    LIST_STACK_CONFLICTS=unknown
  fi

  for ((i = 0; i < ${#LIST_IDS[@]}; i++)); do
    order=$((order + 1))
    printf '%s. %s\n' "$order" "${LIST_NAMES[$i]}"
    printf '   source: %s (%s)\n' "${LIST_SOURCES[$i]}" \
      "${LIST_STATES[$i]}"
    printf '   delivery: %s\n' "${LIST_DELIVERIES[$i]}"
    printf '   conflicts: %s\n' "$(printf '%s' "${LIST_CONFLICTS[$i]}" |
      tr '\n' ',' | sed 's/,$//; s/,/, /g')"
  done
  printf '   stack conflicts: %s\n' "$(printf '%s' "$LIST_STACK_CONFLICTS" |
    tr '\n' ',' | sed 's/,$//; s/,/, /g')"
}

command_log() {
  [ "$#" -eq 0 ] || die "bruk: git patch log"
  local entry operation found=0
  local pattern

  stack_context
  pattern="^git-patch\\.${STACK_ID}\\.operations(\\.value)?$"
  while IFS= read -r -d '' entry; do
    operation=${entry#*$'\n'}
    printf '%s\n' "$operation"
    found=1
  done < <(git config --local --null --get-regexp "$pattern" 2>/dev/null)

  if [ "$found" -eq 0 ]; then
    printf 'Ingen stack-historikk ennå.\n'
  fi
}

command_publish_stacked() {
  [ "$#" -eq 0 ] || die "bruk: git patch publish-stacked"
  local id source branch base_ref existing_stack
  local -a branches=()

  stack_context
  load_stack
  [ -n "$STACK_PATCHES" ] ||
    die "ingen aktive patcher å publisere"

  has_worktree_changes &&
    die "arbeidstreet har ucommittede endringer; commit eller stash dem før publisering"

  for id in $(stack_patch_ids); do
    source=$(git config --local --get "$(patch_meta_key "$id" source)" ||
      patch_name_for_id "$id") ||
      die "stack-metadata mangler source-branch for patchen '$id'"
    git show-ref --verify --quiet "refs/heads/$source" ||
      die "fant ikke den lokale source-branchen '$source'"
    branches[${#branches[@]}]=$source
  done
  branches[${#branches[@]}]=$CURRENT_BRANCH

  base_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) ||
    die "fant ikke origin/HEAD; konfigurer standardbranchen for origin"
  branch=${base_ref#origin/}

  command -v gh >/dev/null 2>&1 ||
    die "GitHub CLI (gh) er nødvendig for å publisere en stack"
  gh stack --help >/dev/null 2>&1 ||
    die "gh-stack-utvidelsen mangler; installer den før publisering"
  gh auth status >/dev/null 2>&1 ||
    die "gh er ikke autentisert; kjør 'gh auth login'"
  gh repo view --json nameWithOwner >/dev/null 2>&1 ||
    die "fant ingen GitHub-repositorykonfigurasjon for dette repoet"

  existing_stack=$(gh stack view --json 2>/dev/null || true)
  if [ -n "$existing_stack" ]; then
    gh stack unstack --local ||
      die "kunne ikke oppdatere eksisterende lokal gh-stack-konfigurasjon"
  fi
  gh stack init --base "$branch" "${branches[@]}" ||
    die "gh stack init feilet; ingen lokal stackhistorikk ble omskrevet av git-patch"
  gh stack submit --auto ||
    die "gh stack submit feilet"

  printf 'Publiserte patch-stacken med gh stack.\n'
}

case ${1-} in
  -h|--help|help)
    usage
    exit 0
    ;;
  add)
    shift
    command_add "$@"
    ;;
  check-conflicts)
    shift
    command_check_conflicts "$@"
    ;;
  sync)
    shift
    command_sync "$@"
    ;;
  log)
    shift
    [ "$#" -eq 0 ] || die "bruk: git patch log"
    command_log
    ;;
  list)
    shift
    command_list "$@"
    ;;
  drop)
    shift
    command_drop "$@"
    ;;
  publish-stacked)
    shift
    command_publish_stacked "$@"
    ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    printf '%s: unknown command: %s\n' "$program" "$1" >&2
    usage >&2
    exit 2
    ;;
esac
